# Copy this file to `.env` (both Prisma and Next.js read `.env`).
#   cp .env.example .env

# SQLite for local development. The path is relative to prisma/schema.prisma,
# so this points at the committed demo database in prisma/prisma/dev.db.
DATABASE_URL="file:./prisma/dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Any long random string, e.g. the output of: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"

# Optional: Google sign-in (the email sign-in works without these)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: AI assistant chat (the rest of the app works without it)
OPENAI_API_KEY=""
